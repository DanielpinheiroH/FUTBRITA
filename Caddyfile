{
  admin off
}

{$DUCKDNS_DOMAIN:futbrita.duckdns.org} {
  encode zstd gzip
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    -Server
  }
  reverse_proxy api:3333
  log {
    output stdout
    format json
  }
}
